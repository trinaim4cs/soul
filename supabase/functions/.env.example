# Edge Function secrets (D-052). Local: copy to supabase/functions/.env (git-ignored).
# Hosted: `npx supabase secrets set NAME=value` (never commit real values).
SOUL_ENV=development            # only development may use the mock provider
PAYMENTS_PROVIDER=mock          # razorpay | mock
PAYMENTS_SITE_URL=http://localhost:8081
RAZORPAY_KEY_ID=                # rzp_test_… for test mode, rzp_live_… for production
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=        # the secret you set on the webhook in the Razorpay dashboard
# Push (D-054). Generate VAPID keys once per environment (see SUPABASE.md); never reuse local keys.
VAPID_PUBLIC_KEY=               # base64url, 65-byte uncompressed P-256 point
VAPID_PRIVATE_KEY=              # base64url, 32 bytes
VAPID_SUBJECT=mailto:           # a contact address for push services
FCM_SERVICE_ACCOUNT=            # the Firebase service account JSON, on one line
