# SOUL server secrets for the hosted project (copy to supabase/functions/.env.production,
# which git ignores). These never go into the app or the website.
#
#   npm run env:init -- production      creates the file and fills in fresh Web Push keys
#   npm run env:check -- production     checks every value without printing any of them
#   npx supabase secrets set --env-file supabase/functions/.env.production
#                                       sends them to the hosted Edge Functions (SUPABASE.md)
#
# One value per line, no quotes needed, comments on their own lines only.

# Production: the mock payment provider is refused (D-057).
SOUL_ENV=production

# Payments (D-052, C-25). Razorpay dashboard -> Account & Settings -> API keys. Use the test
# keys (rzp_test_...) until live payments are approved, then the live ones (rzp_live_...).
PAYMENTS_PROVIDER=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Razorpay -> Webhooks: the secret you type when adding the webhook for
# https://bdwuhrkgrwzpwqhgsngi.supabase.co/functions/v1/payments-webhook
RAZORPAY_WEBHOOK_SECRET=
# Where checkout returns the person: the SOUL website (https, no trailing slash).
PAYMENTS_SITE_URL=

# Web Push for the iPhone PWA (D-054). A key pair for this environment only, never the
# local one: `npm run env:init -- production` generates it. Changing it later makes every
# web subscriber turn notifications on again.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact for the push services: mailto:you@example.com or an https page.
VAPID_SUBJECT=

# Android push through Firebase Cloud Messaging (C-16). Firebase console -> Project settings
# -> Service accounts -> Generate new private key; paste the whole JSON here on one line.
# Optional: without it Android simply gets no notifications.
FCM_SERVICE_ACCOUNT=
