# SOUL app, production values (copy to .env.production, which git ignores).
#
# Read by release builds (`npm run android:release`) and the web export for the PWA
# (`npm run web:export`; on a host such as Vercel, set the same three variables in its
# settings instead). Check it with `npm run env:check -- production`.
#
# Only client-safe values belong here: everything in this file is visible inside the APK and
# the website. Never the service-role key, a secret key, or any server secret (those go in
# supabase/functions/.env.production).

APP_ENV=production

# Supabase dashboard -> Project Settings -> API: the project URL (https).
EXPO_PUBLIC_SUPABASE_URL=https://bdwuhrkgrwzpwqhgsngi.supabase.co

# Same page: the publishable key (sb_publishable_...) or the legacy "anon" public key.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
