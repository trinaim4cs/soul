# Copy to .env (git-ignored). Only EXPO_PUBLIC_* values are bundled into the app.
# Never put the Supabase service-role key or any other secret here.
APP_ENV=development
# Android emulator reaches the host machine at 10.0.2.2 (the web dev build maps it to localhost)
EXPO_PUBLIC_SUPABASE_URL=http://10.0.2.2:54321
EXPO_PUBLIC_SUPABASE_ANON_KEY=replace-with-local-publishable-key

# Production / beta builds read .env.production (also git-ignored) with APP_ENV=production and the
# cloud project's URL and publishable key. On Vercel, set the same three variables in the project
# settings instead (PWA.md).
